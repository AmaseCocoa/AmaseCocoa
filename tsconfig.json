{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,

    "strict": true,
    "skipLibCheck": true,

    "isolatedDeclarations": false,

    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": true,

    "types": ["node"]
  },
  "include": ["AmaseCocoa/src/**/*"]
}
